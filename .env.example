# =============================================================================
# Root .env.example — Docker Compose environment variables
# Copy this file to .env and fill in your values before starting.
# NEVER commit the actual .env file.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=doctor_management
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=change_me_in_production

# ---- Backend ----
DATABASE_URL=postgresql+psycopg://dms_user:change_me_in_production@db:5432/doctor_management
SECRET_KEY=change_me_super_secret_jwt_key_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Demo / Seed ----
SEED_DEMO_DATA=true
